From: Emre Yavuzalp <emreyavuzalp@gmail.com>
Subject: econet-eth: fix big-endian eth-mangle so bound flows get a valid MAC

nf_flow_table_offload encodes the L2 rewrite as host u32 value/mask pairs laid
out for a little-endian CPU. The upstream mtk byte-copy only matched that on
LE; on this big-endian MIPS the two 2-byte MAC halves (dst MAC[4:6] and src
MAC[0:2]) were written as zero, so every bound flow carried a bogus next-hop
MAC (live dump: dst=00:00:00:00:b6:41) and the engine never forwarded it - the
flow kept punting to the CPU (0d climbing, throughput stuck at the software
flowtable level). Decode each fixed action by its mask and place the correct
native bytes. (Drops the temporary ETHMANGLE diag; keeps the L2DIAG line to
confirm the assembled MACs on hardware.)
--- a/econet_ppe_offload.c
+++ b/econet_ppe_offload.c
@@ -202,24 +202,35 @@
 	}
 }
 
+/*
+ * Apply one eth-header rewrite action into the 14-byte L2 scratch buffer.
+ *
+ * nf_flow_table_offload encodes the new MAC addresses as four fixed actions
+ * whose value/mask are host u32s laid out for a LITTLE-ENDIAN CPU (e.g. for
+ * dst[4:6] it does `val = val16; mask = ~0x0000ffff`). The upstream mtk
+ * byte-copy only reproduces that on LE; on this big-endian MIPS the two
+ * 2-byte halves (dst MAC[4:6] and src MAC[0:2]) came out zero, leaving a bogus
+ * next-hop MAC so bound flows never forwarded. Decode each action by its mask
+ * and place the correct native bytes explicitly. (BE target only.)
+ */
 static void
 en75_flow_offload_mangle_eth(const struct flow_action_entry *act, void *eth)
 {
-	void *dest = eth + act->mangle.offset;
-	const void *src = &act->mangle.val;
+	const u8 *vb = (const u8 *)&act->mangle.val;	/* native (BE) bytes */
+	u8 *e = (u8 *)eth;
 
-	pr_info_ratelimited("econet-eth: ETHMANGLE off=%u mask=%08x val=%08x\n",
-			    act->mangle.offset, act->mangle.mask, act->mangle.val);
-
-	if (act->mangle.offset > 8)
-		return;
-
-	if (act->mangle.mask == 0xffff) {
-		src += 2;
-		dest += 2;
+	switch (act->mangle.mask) {
+	case 0x00000000:		/* full word: dst[0:4] (off 0) or src[2:6] (off 8) */
+		if (act->mangle.offset <= 8)
+			memcpy(e + act->mangle.offset, vb, 4);
+		break;
+	case 0xffff0000:		/* dst MAC[4:6] -> eth[4:6] */
+		memcpy(e + 4, vb + 2, 2);
+		break;
+	case 0x0000ffff:		/* src MAC[0:2] -> eth[6:8] */
+		memcpy(e + 6, vb, 2);
+		break;
 	}
-
-	memcpy(dest, src, act->mangle.mask ? 2 : 4);
 }
 
 static int
