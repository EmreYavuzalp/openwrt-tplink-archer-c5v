#!/bin/sh /etc/rc.common
# Ön panel LED durum daemon'u (WAN link + internet). Firmware'e gömülü.

START=95
USE_PROCD=1

start_service() {
	# İlgili LED'ler yoksa başlatma
	[ -d /sys/class/leds/blue:wan ] || [ -d /sys/class/leds/blue:wan-online ] || return 0

	procd_open_instance
	procd_set_param command /usr/sbin/led-status
	procd_set_param respawn
	procd_close_instance
}
